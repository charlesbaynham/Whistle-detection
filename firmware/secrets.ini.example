; Copy to secrets.ini (gitignored) and fill in.
[secrets]
wifi_ssid = MyNetwork
wifi_password = hunter2
ota_password = pick-something
; mDNS name: device appears as <hostname>.local. Use one per node (whistle-kitchen, ...).
hostname = whistle-echo
; host:port of the whistle-lab server that receives trigger clips and heartbeats (e.g. a laptop
; running `uv run whistle-lab`). Empty: nothing is uploaded.
debug_server = 192.168.1.10:8000
