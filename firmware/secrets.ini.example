; Copy to secrets.ini (gitignored) and fill in.
[secrets]
wifi_ssid = MyNetwork
wifi_password = hunter2
ota_password = pick-something
; mDNS name: device appears as <hostname>.local. Use one per node (whistle-kitchen, ...).
hostname = whistle-echo
; Where trigger clips and heartbeats go: host:port, http://host[:port] or https://host[:port].
; The deployed server is https://whistle.i.houseabsolute.co.uk (LAN/tailnet only, no SSO); a laptop
; running `uv run whistle-lab` is e.g. 192.168.1.10:8000. Empty: nothing is uploaded.
debug_server = https://whistle.i.houseabsolute.co.uk
; Optional shared secret, sent as X-Whistle-Token. Must match the server's WHISTLE_DEVICE_TOKEN env var.
device_token =
; MQTT broker for Home Assistant (docs/mqtt.md), e.g. the HA Mosquitto add-on. Empty host: no MQTT.
; Give each node its own broker user.
mqtt_host = homeassistant.local
mqtt_port = 1883
mqtt_user = whistle-echo
mqtt_password =
